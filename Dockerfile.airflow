# Imagem do Airflow com o pacote `triage` instalado.
#
# A DAG importa `triage.model.train` e `triage.data.loader` diretamente, então o pacote
# precisa estar no ambiente do worker. A alternativa — instalar em tempo de execução
# dentro da tarefa — deixaria a DAG dependente de rede a cada run e esconderia falhas de
# dependência no log da tarefa em vez de no build.
#
# O Airflow NÃO entra no ambiente de desenvolvimento do projeto: ele arrastaria dezenas
# de pacotes para o venv e conflitaria com as versões de scikit-learn e pandas que o
# treino usa. Ele vive aqui, isolado.
#
# O núcleo científico vem fixado do uv.lock. Sem isso, esta imagem e a da API convergem
# para versões diferentes de scikit-learn: o modelo é serializado por uma e desserializado
# pela outra, o que o próprio scikit-learn classifica como uso por conta e risco. Foi o
# que aconteceu — a DAG publicava um pickle da 1.8.0 que a API carregava com a 1.9.0.
#
# O alinhamento é feito por *constraints* de um punhado de pacotes, não instalando o lock
# inteiro. Instalar o lock completo por cima da imagem oficial sobe protobuf para a 7.x e
# quebra o opentelemetry-proto que o Airflow usa internamente: o resultado é uma tarefa
# que entra em execução e trava sem escrever uma linha de log.

FROM python:3.11-slim AS deps

COPY --from=ghcr.io/astral-sh/uv:0.12.12 /uv /bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./

# Apenas os pacotes que participam da serialização do modelo. O resto do ambiente
# continua sendo o que o Airflow já validou.
RUN uv export --frozen --no-dev --extra pipeline --no-emit-project --no-hashes \
        -o /full.txt \
    && grep -E '^(scikit-learn|scipy|joblib|numpy)==' /full.txt > /constraints.txt \
    && cat /constraints.txt


FROM apache/airflow:3.2.2-python3.11

USER root

# O pip do Airflow precisa compilar nada, mas o pacote é instalado a partir do
# código-fonte, então o diretório precisa existir com a posse correta.
RUN mkdir -p /opt/triage && chown airflow:root /opt/triage

# O banco de metadados vai para um diretório próprio, montado como volume nomeado, para
# sobreviver à recriação do container. O modo g+w é o que permite ao volume ser escrito
# quando o container roda com o uid do host e grupo 0 — um volume novo herda dono e
# permissões do diretório correspondente na imagem.
RUN mkdir -p /opt/airflow/db && chown airflow:root /opt/airflow/db && chmod 775 /opt/airflow/db

USER airflow

# Camada de dependências: só é reconstruída quando o pyproject muda, não a cada
# alteração de código.
COPY --chown=airflow:root pyproject.toml README.md /opt/triage/
COPY --chown=airflow:root src /opt/triage/src

COPY --from=deps --chown=airflow:root /constraints.txt /opt/triage/constraints.txt

# O constraint força as versões do lock para os pacotes listados; tudo o mais é
# resolvido normalmente e o ambiente do Airflow permanece intacto.
RUN pip install --no-cache-dir -c /opt/triage/constraints.txt "/opt/triage[pipeline]"

ENV PYTHONDONTWRITEBYTECODE=1 \
    AIRFLOW__CORE__LOAD_EXAMPLES=False \
    AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags \
    TRIAGE_DATA_DIR=/opt/airflow/data \
    TRIAGE_MODELS_DIR=/opt/airflow/models
