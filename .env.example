# Copie para `.env` e ajuste conforme necessário.
# Todas as variáveis são opcionais — os defaults estão em src/triage/config.py.

# Caminhos
TRIAGE_DATA_DIR=data
TRIAGE_MODELS_DIR=models

# Dados
TRIAGE_KAGGLE_DATASET=saharalaa/medical-abstracts-tc-corpus

# Treino
TRIAGE_TEST_SIZE=0.2

# Ponto de operação da triagem: fração dos laudos urgentes que queremos capturar.
# É decisão institucional, não hiperparâmetro — subir isso aumenta o recall de
# `urgente` e o número de falsos alarmes na fila prioritária.
TRIAGE_URGENT_RECALL_TARGET=0.90

# Gates de qualidade da DAG de treino: abaixo disso o retreino falha e não publica
TRIAGE_MIN_RECALL_URGENTE=0.85
TRIAGE_MIN_F1_MACRO=0.52

# Inferência: `sklearn` ou `onnx`
TRIAGE_MODEL_BACKEND=sklearn

# API
TRIAGE_API_HOST=0.0.0.0
TRIAGE_API_PORT=8000

TRIAGE_LOG_LEVEL=INFO
