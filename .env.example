# Copie para `.env` e ajuste conforme necessário.
# Todas as variáveis são opcionais — os defaults estão em src/triage/config.py.

# Caminhos
TRIAGE_DATA_DIR=data
TRIAGE_MODELS_DIR=models

# Dados
TRIAGE_KAGGLE_DATASET=saharalaa/medical-abstracts-tc-corpus

# Treino
TRIAGE_TEST_SIZE=0.2
# Gate de qualidade da DAG de treino: abaixo disso o retreino falha
TRIAGE_MIN_F1_MACRO=0.55

# Inferência: `sklearn` ou `onnx`
TRIAGE_MODEL_BACKEND=sklearn

# API
TRIAGE_API_HOST=0.0.0.0
TRIAGE_API_PORT=8000

TRIAGE_LOG_LEVEL=INFO
